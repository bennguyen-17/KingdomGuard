  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.92156863, g: 0.9411765, b: 0.9607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 21
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.3
  m_Text: "<b>1. CORE OBJECTIVE</b>\n\u2022 Protect the Castle through <b>6 invading monster waves</b>.\n\u2022 Starting resources: <b>200 Gold</b> & <b>20 Castle HP</b> (leaked monsters deplete HP).\n\n<b>2. DEFENSE TOWERS</b>\n\u2022 <b>Archer Tower (50G):</b> High attack rate (0.5s), long range (3.5), targets first enemy.\n\u2022 <b>Cannon Tower (100G):</b> Area-of-effect (AOE) splash damage, 15% crit chance (x1.5 damage).\n\n<b>3. INVADING MONSTERS</b>\n\u2022 <b>Goblin:</b> Fast movement, 50 HP, drops <b>5 Gold</b> (breaches castle for -1 HP).\n\u2022 <b>Orc:</b> High durability, 150 HP, drops <b>10 Gold</b> (appears from Wave 4, breaches castle for -2 HP).\n\n<b>4. CONTROLS & SHORTCUTS</b>\n\u2022 <b>Left Click:</b> Click empty build tile to build. Click existing tower to <b>Upgrade</b> or <b>Sell</b>.\n\u2022 <b>Space Key:</b> Start wave immediately or skip break countdown.\n\u2022 <b>Esc / P Key:</b> Pause the battle."
